RewriteEngine On

# Serve real files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes to the front controller
RewriteRule ^ index.php [L]

# Block dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
